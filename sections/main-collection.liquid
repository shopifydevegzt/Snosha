

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

{%- comment -%}
  Snosha (dev1) — opt-in "Snosha collection style": the homepage Snosha product card look (shared
  card rules in assets/dev1.css, scope .snosha-collection-grid) + a column cap for the native grid
  (native card sizes can't give 4 columns in the 1376px container). Only variables are output here;
  filters, sorting, pagination, URLs and the card blocks stay native.
{%- endcomment -%}
{%- liquid
  assign snosha_style = section.settings.snosha_style
-%}
{%- if snosha_style -%}
  {% style %}
    #shopify-section-{{ section.id }} .snosha-collection-grid {
      --snosha-cc-columns: {{ section.settings.snosha_columns_desktop | default: 4 }};
      --snosha-cc-min-card: {{ section.settings.snosha_min_card_width | default: 240 }}px;
      --snosha-cc-col-gap: {{ section.settings.columns_gap_horizontal }}px;
      --snosha-cc-image-bg: {{ section.settings.snosha_image_background | default: settings.color_palette.color5 }};
      --snosha-cc-toolbar-border: {{ section.settings.snosha_toolbar_border | default: settings.color_palette.color2 }};
      --snosha-fc-title: {{ section.settings.snosha_title_color | default: settings.color_palette.color6 }};
      --snosha-fc-text: {{ section.settings.snosha_text_color | default: settings.color_palette.color1 }};
      --snosha-fc-accent: {{ section.settings.snosha_accent_color | default: settings.color_palette.color3 }};
      --snosha-fc-on-accent: {{ section.settings.snosha_accent_text_color | default: settings.color_palette.background }};
      --snosha-fc-star: {{ section.settings.snosha_star_color | default: settings.color_palette.color4 }};
      --snosha-fc-discount-bg: {{ section.settings.snosha_discount_background | default: settings.color_palette.color5 }};
      --snosha-fc-discount-border: {{ section.settings.snosha_discount_border | default: settings.color_palette.color2 }};
      --snosha-fc-gradient-end: {{ section.settings.snosha_shadow_color | default: '#0F64A8' }};
    }
  {% endstyle %}
{%- endif -%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-component
  {% if snosha_style %}
    class="snosha-collection-grid"
  {% endif %}
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Snosha collection style"
    },
    {
      "type": "checkbox",
      "id": "snosha_style",
      "label": "Snosha collection style",
      "info": "Homepage best-seller card look, a column limit for the grid and a styled filter bar. Filters, sorting and the card blocks stay native.",
      "default": false
    },
    {
      "type": "range",
      "id": "snosha_columns_desktop",
      "label": "Maximum columns",
      "info": "Fewer columns are used when cards would be narrower than the minimum width (e.g. 4 at 1480px, 3 at 1024px, 2 at 750px). Mobile: \"Mobile card size\".",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "range",
      "id": "snosha_min_card_width",
      "label": "Minimum card width",
      "min": 180,
      "max": 360,
      "step": 4,
      "unit": "px",
      "default": 240,
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_image_background",
      "label": "Product image background",
      "default": "{{ settings.color_palette.color5 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_title_color",
      "label": "Product title and price",
      "default": "{{ settings.color_palette.color6 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_text_color",
      "label": "Secondary text",
      "default": "{{ settings.color_palette.color1 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_accent_color",
      "label": "Accent (badges, links, buttons)",
      "default": "{{ settings.color_palette.color3 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_accent_text_color",
      "label": "Text on accent",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_star_color",
      "label": "Rating stars",
      "default": "{{ settings.color_palette.color4 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_discount_background",
      "label": "Discount badge background",
      "default": "{{ settings.color_palette.color5 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_discount_border",
      "label": "Discount badge border",
      "default": "{{ settings.color_palette.color2 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_shadow_color",
      "label": "Card hover shadow",
      "default": "#0F64A8",
      "visible_if": "{{ section.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_toolbar_border",
      "label": "Filter bar border",
      "default": "{{ settings.color_palette.color2 }}",
      "visible_if": "{{ section.settings.snosha_style }}"
    }
  ],
  "presets": []
}
{% endschema %}
