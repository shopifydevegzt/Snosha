

{% liquid
  assign max_items = section.settings.post_limit
%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  # Snosha: opt-in design (off by default, so other blog sections are unchanged). Styles live in assets/dev1.css.
  assign snosha_style = section.settings.snosha_style
  assign snosha_progress = false
  if snosha_style and section.settings.snosha_show_progress and section.settings.layout_type == 'carousel'
    assign snosha_progress = true
  endif
  assign view_all_label = section.settings.view_all_label | strip
  assign view_all_url = section.settings.view_all_url | default: section.settings.blog.url
%}

{%- if snosha_style -%}
  {% style %}
    #shopify-section-{{ section.id }} .snosha-blog {
      --snosha-blog-heading: {{ section.settings.snosha_heading_color }};
      --snosha-blog-subtitle: {{ section.settings.snosha_subtitle_color }};
      --snosha-blog-title: {{ section.settings.snosha_title_color }};
      --snosha-blog-date: {{ section.settings.snosha_date_color }};
      --snosha-blog-excerpt: {{ section.settings.snosha_excerpt_color }};
      --snosha-blog-image-height: {{ section.settings.snosha_image_height }}px;
      --snosha-blog-image-height-mobile: {{ section.settings.snosha_image_height_mobile }}px;
      --snosha-blog-image-position: {{ section.settings.snosha_image_position }};
      --snosha-blog-accent: {{ section.settings.snosha_accent_color }};
      --snosha-blog-progress-track: {{ section.settings.snosha_progress_track }};
      --snosha-blog-gradient-start: {{ section.settings.snosha_gradient_start }};
      --snosha-blog-gradient-end: {{ section.settings.snosha_gradient_end }};
      --snosha-blog-mobile-padding-start: {{ section.settings.snosha_mobile_padding_top }}px;
      --snosha-blog-mobile-padding-end: {{ section.settings.snosha_mobile_padding_bottom }}px;
    }
  {% endstyle %}
{%- endif -%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
    {% if snosha_style %}snosha-blog{% unless snosha_progress %} snosha-blog--no-progress{% endunless %}{% endif %}
    {% if section.settings.custom_class != blank %}{{ section.settings.custom_class | escape }}{% endif %}
  "
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    {%- render 'gap-style', value: section.settings.gap -%}
  "
  {% if snosha_progress %}
    data-snosha-carousel-progress
  {% endif %}
>
  {%- capture view_all_link -%}
    {%- if view_all_label != blank and view_all_url != blank -%}
      <a class="featured-blog-posts__view-all" href="{{ view_all_url }}">
        <span>{{ view_all_label | escape }}</span>
        {%- if snosha_style -%}
          {%- render 'snosha-icon', icon: 'arrow_left', class: 'featured-blog-posts__view-all-icon' -%}
        {%- endif -%}
      </a>
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%} Header wrapper (unstyled by default) so the optional View all link can sit next to the title. {%- endcomment -%}
  <div class="section-resource-list__header">
    {% content_for 'block', id: 'static-blog-title', type: '_featured-blog-posts-title' %}
    {{ view_all_link }}
  </div>

  {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
    {% paginate section.settings.blog.articles by max_items %}
      {% assign section_articles = section.settings.blog.articles %}
    {% endpaginate %}
  {% else %}
    {% assign section_articles = '' %}
    {% for i in (1..max_items) %}
      {% assign section_articles = section_articles | append: ', ' %}
    {% endfor %}
    {% assign section_articles = section_articles | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% for article in section_articles limit: max_items %}
      <div class="resource-list__item">
        {% content_for 'block', id: 'static-blog-post-card', type: '_featured-blog-posts-card', article: article, closest.article: article %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'featuredBlog',
    slide_count: max_items,
    content_type: 'articles',
    test_id: 'featured-blog-posts'
  %}

  {%- if snosha_progress -%}
    {%- comment -%} The mobile progress bar is CSS (assets/dev1.css); this module is only a fallback for browsers without scroll-driven animations. {%- endcomment -%}
    <script src="{{ 'snosha-carousel-progress.js' | asset_url }}" type="module" fetchpriority="low"></script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.blog_posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "featured-blog-posts",
  "blocks": [
    {
      "type": "_featured-blog-posts-title"
    },
    {
