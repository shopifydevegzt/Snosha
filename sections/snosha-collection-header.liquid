{%- comment -%}
  Snosha — collection header (collection template). Compact band, no tall hero:
  breadcrumbs → H1 collection title → optional description; optional collection image at the
  inline end (desktop) / above the text (mobile, opt-in). Everything comes from the current
  collection (title, description, image), so one instance works for every collection.
  Horizon 4.4 has no breadcrumbs or collection-header section; the grid, filters and sorting below
  stay Horizon's native main-collection. Styles: assets/dev1.css (.snosha-collection-header);
  opt-in background image: assets/main.css (.snosha-collection-header-bg).
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign description = collection.description | strip
  assign show_description = false
  if ss.show_description and description != blank
    assign show_description = true
  endif
  assign image = collection.image
  assign show_image = false
  if ss.show_image and image != blank
    assign show_image = true
  endif
  assign title = collection.title | default: page_title

  # Opt-in background image (blank / off by default = original solid-color output).
  # Order: the collection's own image (if enabled and set) → the picked image (can be connected
  # to a collection metafield as a dynamic source) → no image (background color only).
  # The shared mobile image only pairs with the picked image, never with a collection's own image.
  assign bg_image = blank
  assign bg_image_mobile = blank
  if ss.background_use_collection_image and collection.image != blank
    assign bg_image = collection.image
  elsif ss.background_image != blank
    assign bg_image = ss.background_image
    assign bg_image_mobile = ss.background_image_mobile
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .snosha-collection-header {
    --snosha-ch-bg: {{ ss.background }};
    --snosha-ch-title: {{ ss.title_color }};
    --snosha-ch-text: {{ ss.text_color }};
    --snosha-ch-accent: {{ ss.accent_color }};
    --snosha-ch-title-size: {{ ss.title_size }}px;
    --snosha-ch-title-size-mobile: {{ ss.title_size_mobile }}px;
    --snosha-ch-description-lines: {{ ss.description_lines | at_least: 1 }};
    --snosha-ch-image-width: {{ ss.image_width }}px;
    --snosha-ch-padding-start: {{ ss.padding_top }}px;
    --snosha-ch-padding-end: {{ ss.padding_bottom }}px;
    --snosha-ch-padding-start-mobile: {{ ss.padding_top_mobile }}px;
    --snosha-ch-padding-end-mobile: {{ ss.padding_bottom_mobile }}px;
    {%- if bg_image != blank %}
      --snosha-ch-bg-overlay: {{ ss.background_overlay | default: 'transparent' }};
      --snosha-ch-bg-position: {{ bg_image.presentation.focal_point | default: 'center' }};
      {%- if bg_image_mobile != blank %}
        --snosha-ch-bg-position-mobile: {{ bg_image_mobile.presentation.focal_point | default: 'center' }};
      {%- endif %}
    {%- endif %}
  }
{% endstyle %}

<div
  class="snosha-collection-header snosha-collection-header--{{ ss.alignment }}{% if ss.description_lines > 0 %} snosha-collection-header--clamp{% endif %}{% if show_image %} snosha-collection-header--has-image{% unless ss.show_image_mobile %} snosha-collection-header--image-desktop-only{% endunless %}{% endif %}{% if bg_image != blank %} snosha-collection-header-bg{% endif %}{% if ss.custom_class != blank %} {{ ss.custom_class | escape }}{% endif %}"
>
  {%- if bg_image != blank -%}
    {%- comment -%} Decorative background (alt=""): the H1 carries the meaning. Above the fold → eager + high priority (LCP). {%- endcomment -%}
    <picture class="snosha-collection-header-bg__media" aria-hidden="true">
      {%- if bg_image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ bg_image_mobile | image_url: width: 480 }} 480w, {{ bg_image_mobile | image_url: width: 750 }} 750w, {{ bg_image_mobile | image_url: width: 1100 }} 1100w, {{ bg_image_mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          width="{{ bg_image_mobile.width }}"
          height="{{ bg_image_mobile.height }}"
        >
      {%- endif -%}
      {{-
        bg_image
        | image_url: width: 2560
        | image_tag:
          class: 'snosha-collection-header-bg__image',
          widths: '480, 750, 1100, 1500, 1920, 2560',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      -}}
    </picture>
  {%- endif -%}
  <div class="section section--page-width">
    <div class="snosha-collection-header__inner">
      <div class="snosha-collection-header__text">
        {%- if ss.show_breadcrumbs -%}
          {%- render 'snosha-breadcrumbs', home_label: ss.home_label, aria_label: ss.breadcrumbs_label -%}
        {%- endif -%}

        <h1 class="snosha-collection-header__title">{{ title | escape }}</h1>

        {%- if show_description -%}
          <div class="snosha-collection-header__description rte">{{ description }}</div>
        {%- endif -%}
      </div>

      {%- if show_image -%}
        <div class="snosha-collection-header__media">
          {{-
            image
            | image_url: width: 1200
            | image_tag:
              class: 'snosha-collection-header__image',
              widths: '240, 360, 480, 720, 960, 1200',
              sizes: '(min-width: 750px) min(40vw, 480px), calc(100vw - 48px)',
              loading: 'eager',
              fetchpriority: 'high',
              alt: image.alt | default: title
          -}}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Snosha collection header",
  "tag": "section",
  "class": "snosha-collection-header-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Title, description and image come from the collection being viewed (Products → Collections)."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumbs home label",
      "default": "الرئيسية",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "text",
      "id": "breadcrumbs_label",
      "label": "Breadcrumbs accessible name",
      "info": "Read by screen readers for the breadcrumbs navigation.",
      "default": "مسار التنقل",
      "visible_if": "{{ section.settings.show_breadcrumbs }}"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "info": "Only shown when the collection has a description.",
      "default": true
    },
    {
      "type": "range",
      "id": "description_lines",
      "label": "Description lines",
      "info": "0 shows the full description.",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.show_description }}"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "info": "Only shown when the collection has an image.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image_mobile",
      "label": "Show collection image on mobile",
      "default": false,
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 160,
      "max": 480,
      "step": 8,
      "unit": "px",
      "default": 320,
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "info": "With a collection image, the text is aligned to the start on desktop.",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "start", "label": "Start" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size on mobile",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "{{ settings.color_palette.color6 }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description and breadcrumbs",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Links",
      "default": "{{ settings.color_palette.color3 }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "alpha": true,
      "default": "{{ settings.color_palette.color5 }}"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "paragraph",
      "content": "Optional. Replaces the background color. For a different image per collection, turn on the collection image below, or connect the image to a collection metafield (dynamic source)."
    },
    {
      "type": "checkbox",
      "id": "background_use_collection_image",
      "label": "Use the collection image as background",
      "info": "Uses the image set on each collection (Products → Collections). Falls back to the image below.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image on mobile",
      "info": "Optional. Used with the background image above (not with a collection's own image). Falls back to the background image."
    },
    {
      "type": "color",
      "id": "background_overlay",
      "label": "Image overlay",
      "info": "Keeps the title readable over the image. Lower the opacity for a lighter tint.",
      "alpha": true,
      "default": "#F0FAFEB3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding on mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding on mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "presets": [
    {
      "name": "Snosha collection header"
    }
  ]
}
{% endschema %}
