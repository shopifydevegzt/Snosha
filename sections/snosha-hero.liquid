        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Overrides the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "عنوان الميزة"
        },
        {
