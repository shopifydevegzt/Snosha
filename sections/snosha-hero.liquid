{%- comment -%}
  Snosha — Hero + Trust Strip (homepage section #3).
  Figma 1fqyznLFgS65tTjGvBYPBm: hero 190:3790 / 335:3960, trust strip 190:4081 / 382:4564.
  New isolated section: the native `hero` cannot anchor spec chips to a positioned product
  image, draw the rings, or overlap a trust card (see SNOSHA_PROJECT_PLAN.md, section #3).
  Static styles live in assets/main.css (.snosha-hero); this file keeps the markup, the per-instance
  color bridge (style tag below) and the schema. Breakpoints: < 750 mobile, 750–989 stacked, >= 990 split.
{%- endcomment -%}
{%- liquid
  assign chips = section.blocks | where: 'type', 'spec_chip'
  assign trust_items = section.blocks | where: 'type', 'trust_item'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  # Slide artwork per storefront language: Arabic images on the Arabic storefront, English images everywhere else
  assign slide_language = request.locale.iso_code | slice: 0, 2
  assign slide_count = 1
  for block in slide_blocks
    if block.settings.image_desktop_ar != blank or block.settings.image_desktop_en != blank or block.settings.image_mobile_ar != blank or block.settings.image_mobile_en != blank or request.design_mode
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  assign use_slideshow = false
  if section.settings.enable_slideshow and slide_count > 1
    assign use_slideshow = true
  endif
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign custom_class = section.settings.custom_class | strip | escape
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --snosha-hero-start: {{ section.settings.gradient_start }};
    --snosha-hero-mid: {{ section.settings.gradient_middle }};
    --snosha-hero-end: {{ section.settings.gradient_end }};
    {%- if section.settings.image_shadow_color != blank %}
    --snosha-hero-image-shadow: {{ section.settings.image_shadow_color }};
    {%- endif %}
    --snosha-hero-text: {{ section.settings.text_color }};
    --snosha-hero-highlight: {{ section.settings.highlight_color }};
    --snosha-hero-chip-text: {{ section.settings.chip_text_color }};
    --snosha-hero-button-bg: {{ section.settings.button_background }};
    --snosha-hero-trust-bg: {{ section.settings.trust_background }};
    --snosha-hero-trust-title: {{ section.settings.trust_title_color }};
    --snosha-hero-trust-text: {{ section.settings.trust_text_color }};
    --snosha-hero-trust-border: {{ section.settings.trust_border_color }};
    --snosha-hero-trust-tile: {{ section.settings.trust_tile_color }};
    --snosha-hero-trust-icon: {{ section.settings.trust_icon_color }};
    --snosha-hero-trust-icon-accent: {{ section.settings.trust_icon_accent_color }};
    --snosha-hero-min-height: {{ section.settings.desktop_height }}px;
    --snosha-hero-padding-end: {{ section.settings.padding_block_end }}px;
  }
{% endstyle %}

<div class="snosha-hero{% if use_slideshow %} snosha-hero--slideshow{% endif %}{% if custom_class != blank %} {{ custom_class }}{% endif %}">
  {%- comment -%}
    The original hero (section settings + spec chips) is captured once. Without Slide blocks it is output
    exactly as before; with Slide blocks it becomes slide 1 of Horizon's native slideshow (snippets/slideshow),
    followed by one image-only slide per Slide block. The trust strip stays outside the slideshow.
  {%- endcomment -%}
  {%- capture hero_band -%}
  <div class="snosha-hero__band">
    <div class="section section--page-width snosha-hero__band-grid">
      <div class="snosha-hero__inner">
        <div class="snosha-hero__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="snosha-hero__eyebrow">
              {%- if section.settings.show_eyebrow_icon -%}
                {%- render 'snosha-icon', icon: 'sparkle', uid: section.id, class: 'snosha-hero__eyebrow-icon' -%}
              {%- endif -%}
              <span dir="auto">{{ section.settings.eyebrow | escape }}</span>
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h1 class="snosha-hero__heading" dir="auto">{{ section.settings.heading }}</h1>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="snosha-hero__text" dir="auto">{{ section.settings.text | escape }}</p>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            {%- if section.settings.button_link != blank -%}
              <a class="snosha-hero__button" href="{{ section.settings.button_link }}">
                <span class="snosha-hero__button-label" dir="auto">{{ section.settings.button_label | escape }}</span>
              </a>
            {%- else -%}
              <a class="snosha-hero__button" role="link" aria-disabled="true">
                <span class="snosha-hero__button-label" dir="auto">{{ section.settings.button_label | escape }}</span>
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="snosha-hero__stage">
          <div class="snosha-hero__decor" aria-hidden="true">
            <span class="snosha-hero__highlight"></span>
            <span class="snosha-hero__ring snosha-hero__ring--1"></span>
            <span class="snosha-hero__ring snosha-hero__ring--2"></span>
            <span class="snosha-hero__ring snosha-hero__ring--3"></span>
          </div>

          <div class="snosha-hero__media">
            {%- if image != blank -%}
              {%- liquid
                assign alt = image.alt | default: section.settings.heading | strip_html | escape
                assign sizes = '(min-width: 990px) min(48vw, 710px), min(100vw, 480px)'
                assign widths = '360, 480, 640, 720, 960, 1200, 1440'
              -%}
              <picture>
                {%- if image_mobile != blank -%}
                  <source
                    media="(max-width: 989px)"
                    srcset="{%- for w in (1..4) -%}{%- assign px = w | times: 240 -%}{{ image_mobile | image_url: width: px }} {{ px }}w{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}"
                    sizes="min(100vw, 480px)"
                    width="{{ image_mobile.width }}"
                    height="{{ image_mobile.height }}"
                  >
                {%- endif -%}
                {{
                  image
                  | image_url: width: 1440
                  | image_tag:
                    class: 'snosha-hero__image',
                    alt: alt,
                    widths: widths,
                    sizes: sizes,
                    loading: 'eager',
                    fetchpriority: 'high'
                }}
              </picture>
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'snosha-hero__image snosha-hero__image--placeholder' }}
            {%- endif -%}
          </div>

          {%- for block in chips -%}
            {%- if block.settings.text != blank -%}
              <div
                class="snosha-hero__chip"
                style="--chip-x: {{ block.settings.desktop_x }}; --chip-y: {{ block.settings.desktop_y }}; --chip-mobile-x: {{ block.settings.mobile_x }}; --chip-mobile-y: {{ block.settings.mobile_y }};"
                {{ block.shopify_attributes }}
              >
                <span class="snosha-hero__chip-label" dir="auto">{{ block.settings.text | escape }}</span>
                <span class="snosha-hero__chip-badge" aria-hidden="true">
                  {%- if block.settings.icon_image != blank -%}
                    {{ block.settings.icon_image | image_url: width: 48 | image_tag: alt: '', class: 'snosha-hero__chip-icon-image', loading: 'lazy' }}
                  {%- elsif block.settings.icon != 'none' -%}
                    {%- render 'snosha-icon', icon: block.settings.icon, uid: block.id -%}
                  {%- endif -%}
                </span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  {%- endcapture -%}

  {%- if use_slideshow -%}
    {%- liquid
      assign slide_index = 0
      assign show_arrows = section.settings.show_slideshow_arrows
      if section.settings.show_slideshow_dots
        assign dots_style = 'dots'
      else
        assign dots_style = 'none'
      endif
    -%}
    {%- capture slides -%}
      {%- render 'slideshow-slide', index: 0, children: hero_band, class: 'snosha-hero__slide' -%}
      {%- for block in slide_blocks -%}
        {%- liquid
          # Missing artwork falls back to the other language's image of the same size, then to the other size
          if slide_language == 'ar'
            assign slide_image = block.settings.image_desktop_ar | default: block.settings.image_desktop_en
            assign slide_image_mobile = block.settings.image_mobile_ar | default: block.settings.image_mobile_en
          else
            assign slide_image = block.settings.image_desktop_en | default: block.settings.image_desktop_ar
            assign slide_image_mobile = block.settings.image_mobile_en | default: block.settings.image_mobile_ar
          endif
          # A slide without any image only shows (as a placeholder) in the Theme Editor
          if slide_image == blank and slide_image_mobile == blank and request.design_mode == false
            continue
          endif
          assign slide_index = slide_index | plus: 1
          assign slide_number = slide_index | plus: 1
          assign slide_alt = slide_image.alt | default: slide_image_mobile.alt | strip_html | escape
        -%}
        {%- capture slide_media -%}
          {%- liquid
            # Focal points set on the images in Shopify Files position the crop (desktop / mobile artwork)
            assign focal_desktop = slide_image.presentation.focal_point | default: slide_image_mobile.presentation.focal_point | default: '50% 50%'
            assign focal_mobile = slide_image_mobile.presentation.focal_point | default: focal_desktop
          -%}
          <div
            class="snosha-hero__slide-media snosha-hero__slide-media--{{ block.settings.image_fit }}"
            style="--snosha-hero-focal: {{ focal_desktop }}; --snosha-hero-focal-mobile: {{ focal_mobile }};"
          >
            {%- if block.settings.link != blank -%}
              <a
                class="snosha-hero__slide-link"
                href="{{ block.settings.link }}"
                {% if slide_alt == blank %}
                  aria-label="{{ 'accessibility.slide_status' | t: index: slide_number, length: slide_count }}"
                {% endif %}
              >
            {%- endif -%}
            {%- if slide_image != blank or slide_image_mobile != blank -%}
              {%- assign desktop_image = slide_image | default: slide_image_mobile -%}
              <picture>
                {%- if slide_image_mobile != blank -%}
                  <source
                    media="(max-width: 989px)"
                    srcset="{%- for w in (1..5) -%}{%- assign px = w | times: 240 -%}{{ slide_image_mobile | image_url: width: px }} {{ px }}w{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}"
                    sizes="100vw"
                    width="{{ slide_image_mobile.width }}"
                    height="{{ slide_image_mobile.height }}"
                  >
                {%- endif -%}
                {{
                  desktop_image
                  | image_url: width: 2880
                  | image_tag:
                    class: 'snosha-hero__slide-image',
                    alt: slide_alt,
                    widths: '750, 1100, 1480, 1920, 2400, 2880',
                    sizes: '100vw',
                    loading: 'lazy'
                }}
              </picture>
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'snosha-hero__slide-image snosha-hero__slide-image--placeholder' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endcapture -%}
        {%- render 'slideshow-slide',
          index: slide_index,
          children: slide_media,
          class: 'snosha-hero__slide',
          attributes: block.shopify_attributes
        -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture controls -%}
      {%- render 'slideshow-controls',
        style: dots_style,
        item_count: slide_count,
        show_arrows: false,
        arrows_on_media: true,
        controls_on_media: true,
        pagination_position: 'center',
        class: 'snosha-hero__dots'
      -%}
    {%- endcapture -%}
    {%- comment -%} <snosha-hero-slideshow> (assets/main.js) makes hidden slides inert {%- endcomment -%}
    <snosha-hero-slideshow class="snosha-hero__slideshow-root">
    {%- render 'slideshow',
      ref: 'snoshaHeroSlideshow',
      class: 'snosha-hero__slideshow',
      slides: slides,
      controls: controls,
      show_arrows: show_arrows,
      animate_arrows: false,
      icon_style: 'chevron',
      icon_shape: 'circle',
      slide_count: slide_count,
      slide_position: 'stretch',
      infinite: true
    -%}
    </snosha-hero-slideshow>
  {%- else -%}
    {{ hero_band }}
  {%- endif -%}

  {%- if trust_items.size > 0 -%}
    <div class="section section--page-width snosha-hero__trust-grid">
      <div class="snosha-hero__trust">
        <ul class="snosha-hero__trust-list" role="list">
          {%- for block in trust_items -%}
            <li class="snosha-hero__trust-item" {{ block.shopify_attributes }}>
              <span class="snosha-hero__trust-tile" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 64 | image_tag: alt: '', class: 'snosha-hero__trust-icon-image', loading: 'lazy' }}
                {%- elsif block.settings.icon != 'none' -%}
                  {%- render 'snosha-icon', icon: block.settings.icon, uid: block.id -%}
                {%- endif -%}
              </span>
              <span class="snosha-hero__trust-copy">
                {%- if block.settings.title != blank -%}
                  <span class="snosha-hero__trust-title" dir="auto">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  {%- if block.settings.subtitle_mobile != blank -%}
                    <span class="snosha-hero__trust-text snosha-hero__trust-text--desktop" dir="auto">{{ block.settings.subtitle | escape }}</span>
                    <span class="snosha-hero__trust-text snosha-hero__trust-text--mobile" dir="auto">{{ block.settings.subtitle_mobile | escape }}</span>
                  {%- else -%}
                    <span class="snosha-hero__trust-text" dir="auto">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Snosha hero",
  "tag": "section",
  "class": "snosha-hero-section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "عناية ذكية بالفم  تكنولوجيا وتصميم مدروس"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow_icon",
      "label": "Show eyebrow icon",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic text uses the highlight color.",
      "default": "العناية <em>الذكية</em> بصحة الفم والأسنان"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "حلول ذكية للعناية بالفم تجمع بين التكنولوجيا والتصميم العملي لتجعل روتينك اليومي أسهل."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "تسوّق الآن"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Transparent PNG recommended. Spec chips are positioned over this image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile product image",
      "info": "Optional. Used below 990px; falls back to the product image."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop hero height",
      "min": 400,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "paragraph",
      "content": "Add Slide blocks to turn the hero into a slideshow: the hero above stays slide 1. With no slides the hero shows as a single banner."
    },
    {
      "type": "checkbox",
      "id": "enable_slideshow",
      "label": "Enable slideshow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slideshow_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slideshow_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero colors"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start / accent",
      "default": "#63CDFF"
    },
    {
      "type": "color",
      "id": "gradient_middle",
      "label": "Gradient middle",
      "default": "{{ settings.color_palette.color3 }}"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#0F64A8"
    },
    {
      "type": "color",
      "id": "image_shadow_color",
      "label": "Product image shadow",
      "default": "#08337359"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Heading highlight",
      "default": "#63CDFF"
    },
    {
      "type": "color",
      "id": "chip_text_color",
      "label": "Spec chip text",
      "default": "{{ settings.color_palette.color6 }}"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "Trust strip colors"
    },
    {
      "type": "color",
      "id": "trust_background",
      "label": "Background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "trust_title_color",
      "label": "Title",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "trust_text_color",
      "label": "Subtitle",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "color",
      "id": "trust_border_color",
      "label": "Dividers and tile border",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "trust_tile_color",
      "label": "Icon tile tint",
      "default": "{{ settings.color_palette.color5 }}"
    },
    {
      "type": "color",
      "id": "trust_icon_color",
      "label": "Icon",
      "default": "{{ settings.color_palette.color3 }}"
    },
    {
      "type": "color",
      "id": "trust_icon_accent_color",
      "label": "Icon accent",
      "default": "{{ settings.color_palette.color4 }}"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "spec_chip",
      "name": "Spec chip",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "ميزة المنتج"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "sonic",
              "label": "Sonic"
            },
            {
              "value": "battery",
              "label": "Battery"
            },
            {
              "value": "sliders",
              "label": "Modes"
            },
            {
              "value": "brush_head",
              "label": "Brush head"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ],
          "default": "sonic"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Overrides the icon above."
        },
        {
          "type": "header",
          "content": "Position on desktop (≥ 990px)"
        },
        {
          "type": "number",
          "id": "desktop_x",
          "label": "Left edge (px)",
          "info": "Position on the 749 × 500 px desktop reference stage (Figma pixels); scales with the stage.",
          "default": 300
        },
        {
          "type": "number",
          "id": "desktop_y",
          "label": "Top (px)",
          "info": "Position on the 749 × 500 px desktop reference stage.",
          "default": 233
        },
        {
          "type": "header",
          "content": "Position on mobile (< 990px)"
        },
        {
          "type": "number",
          "id": "mobile_x",
          "label": "Center (px)",
          "info": "Position on the 342 × 330 px mobile reference stage (Figma pixels); scales with the stage.",
          "default": 171
        },
        {
          "type": "number",
          "id": "mobile_y",
          "label": "Top (px)",
          "info": "Position on the 342 × 330 px mobile reference stage.",
          "default": 148
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "exchange",
              "label": "Exchange"
            },
            {
              "value": "shield_check",
              "label": "Shield"
            }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Overrides the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "عنوان الميزة"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "subtitle_mobile",
          "label": "Subtitle on mobile",
          "info": "Optional shorter text below 990px."
        }
      ]
    },
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "paragraph",
          "content": "Image-only slide shown after the hero above, with separate artwork for the Arabic and English storefronts. The image fills the hero area; text belongs in the artwork itself."
        },
        {
          "type": "header",
          "content": "Arabic storefront"
