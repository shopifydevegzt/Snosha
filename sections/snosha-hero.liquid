            {
              "value": "battery",
              "label": "Battery"
            },
            {
              "value": "sliders",
              "label": "Modes"
            },
            {
              "value": "brush_head",
              "label": "Brush head"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
