{%- comment -%}
  Snosha — Choose Your Care (homepage section #10).
  Figma 1fqyznLFgS65tTjGvBYPBm: desktop 190:3943 (1480 x 1072), mobile 190:4265 (390 x 695).
  Isolated section: Horizon's product-list renders every product with one shared card template, so
  it can't give one card a different layout (the featured variant) or give each product its own spec
  rows without changing the shared product card. Cards are theme blocks (_snosha-care-card) with
  nested spec blocks (_snosha-care-spec); each card picks a real product.
  Layout: static 3-card row from 990px (cards shrink proportionally below the 1480 Figma width);
  below 990px the same row is a native CSS scroll-snap carousel that opens on the featured card.
  The mobile progress bar is a CSS scroll-driven animation of that scroller.
  Static styles: assets/main.css (.snosha-choose-care); behavior: assets/main.js (<snosha-care-carousel>).
{%- endcomment -%}
{%- liquid
  assign custom_class = section.settings.custom_class | strip | escape
  assign carousel_label = section.settings.heading | strip_html | escape
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --snosha-care-bg-start: {{ section.settings.background_start }};
    --snosha-care-bg-end: {{ section.settings.background_end }};
    --snosha-care-heading: {{ section.settings.heading_color }};
    --snosha-care-subtitle: {{ section.settings.subtitle_color }};
    --snosha-care-card-bg: {{ section.settings.card_background }};
    --snosha-care-title: {{ section.settings.title_color }};
    --snosha-care-text: {{ section.settings.text_color }};
    --snosha-care-border: {{ section.settings.border_color }};
    --snosha-care-icon: {{ section.settings.icon_color }};
    --snosha-care-icon-accent: {{ section.settings.icon_accent_color }};
    --snosha-care-accent: {{ section.settings.accent_color }};
    --snosha-care-accent-hover: {{ section.settings.accent_hover_color }};
    --snosha-care-on-accent: {{ section.settings.on_accent_color }};
    --snosha-care-outline: {{ section.settings.outline_color }};
    --snosha-care-tint: {{ section.settings.tint_color }};
    --snosha-care-glow-start: {{ section.settings.glow_start }};
    --snosha-care-glow-end: {{ section.settings.glow_end }};
    --snosha-care-progress-track: {{ section.settings.progress_track }};
  }
{% endstyle %}

<div class="snosha-choose-care{% if custom_class != blank %} {{ custom_class }}{% endif %}">
  <div class="section section--page-width snosha-choose-care__grid">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="snosha-choose-care__heading">
        {%- if section.settings.heading != blank -%}
          <h2 class="snosha-choose-care__title" dir="auto">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="snosha-choose-care__subtitle" dir="auto">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Native scroll-snap carousel; <snosha-care-carousel> (assets/main.js) adds featured centering, mouse drag and a progress fallback {%- endcomment -%}
    <snosha-care-carousel
      class="snosha-choose-care__carousel"
      role="region"
      {% if carousel_label != blank %}
        aria-label="{{ carousel_label }}"
      {% endif %}
    >
      <ul class="snosha-choose-care__track" role="list">
        {%- content_for 'blocks' -%}
      </ul>
    </snosha-care-carousel>

    <div class="snosha-choose-care__progress" aria-hidden="true"></div>
  </div>
</div>

