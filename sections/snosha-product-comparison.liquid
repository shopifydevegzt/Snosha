    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (desktop)",
      "min": 60,
      "max": 240,
      "step": 2,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 40,
      "max": 136,
      "step": 2,
      "unit": "px",
      "default": 114
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)",
