{%- comment -%}
  Snosha — Product comparison (product page section 06, "ليه تشتري SNOSHA N2؟").
  Figma 1fqyznLFgS65tTjGvBYPBm: desktop 190:10461 (1480), mobile 190:11173 (390).

  - Heading and subtitle: static native text blocks (native typography, color, dynamic sources).
  - Rows: _snosha-comparison-row theme blocks (add / remove / drag to reorder), each one <tr>,
    rendered with {% content_for 'blocks' %} into a single semantic <table>.
  - The raised highlighted column, the glass panel and the glows are decorative layers
    (aria-hidden) positioned behind the table's middle column, so row heights stay shared by
    all three columns whatever the text length.
  - Product image: image pickers (desktop / optional mobile) or, opt-in, the current product's
    featured image.
  Not built from native blocks only: Horizon has no table / comparison component with a raised
  overlay column (comparison-slider is a before/after image slider).
  Static styles: assets/dev1.css (.snosha-comparison). No JavaScript.
{%- endcomment -%}
{%- liquid
  assign custom_class = section.settings.custom_class | strip | escape

  assign logo = section.settings.logo_image
  if logo == blank
    assign logo = settings.logo
  endif
  assign brand_label = section.settings.brand_label | strip

  assign desktop_image = section.settings.image
  if desktop_image == blank and section.settings.use_product_image and product
    assign desktop_image = product.featured_image
  endif
  assign mobile_image = section.settings.image_mobile
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign show_image = false
  if section.settings.show_image and desktop_image != blank
    assign show_image = true
  endif
  assign show_mobile_image = false
  if section.settings.show_image and mobile_image != blank
    assign show_mobile_image = true
  endif

  assign criterion_label = section.settings.criterion_label | strip
  assign criterion_label_mobile = section.settings.criterion_label_mobile | strip
  assign manual_label = section.settings.manual_label | strip
  assign manual_label_mobile = section.settings.manual_label_mobile | strip
-%}

{% style %}
  #shopify-section-{{ section.id }} .snosha-comparison {
    --snosha-comparison-bg-start: {{ section.settings.background_start }};
    --snosha-comparison-bg-middle: {{ section.settings.background_middle }};
    --snosha-comparison-bg-end: {{ section.settings.background_end }};
    --snosha-comparison-bg-angle: {{ section.settings.background_angle }}deg;
    --snosha-comparison-bg-angle-mobile: {{ section.settings.background_angle_mobile }}deg;
    --snosha-comparison-heading: {{ section.settings.heading_color }};
    --snosha-comparison-subtitle: {{ section.settings.subtitle_color }};
    --snosha-comparison-text: {{ section.settings.table_text_color }};
    --snosha-comparison-table-bg: {{ section.settings.table_background }};
    --snosha-comparison-table-border: {{ section.settings.table_border }};
    --snosha-comparison-divider: {{ section.settings.table_divider }};
    --snosha-comparison-table-shadow: {{ section.settings.table_shadow }};
    --snosha-comparison-table-radius: {{ section.settings.table_radius }}px;
    --snosha-comparison-table-radius-mobile: {{ section.settings.table_radius_mobile }}px;
    --snosha-comparison-strip-top: {{ section.settings.strip_background_top }};
    --snosha-comparison-strip-bottom: {{ section.settings.strip_background_bottom }};
    --snosha-comparison-strip-border: {{ section.settings.strip_border }};
    --snosha-comparison-strip-text: {{ section.settings.strip_text }};
    --snosha-comparison-strip-divider: {{ section.settings.strip_divider }};
    --snosha-comparison-strip-shadow: {{ section.settings.strip_shadow }};
    --snosha-comparison-strip-glow: {{ section.settings.strip_glow }};
    --snosha-comparison-strip-radius: {{ section.settings.strip_radius }}px;
    --snosha-comparison-strip-radius-mobile: {{ section.settings.strip_radius_mobile }}px;
    --snosha-comparison-logo-width: {{ section.settings.logo_width }}px;
    --snosha-comparison-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    --snosha-comparison-image-width: {{ section.settings.image_width }}px;
    --snosha-comparison-image-overhang: {{ section.settings.image_overhang }}px;
    --snosha-comparison-image-top: {{ section.settings.image_top }}px;
    --snosha-comparison-image-rotate: {{ section.settings.image_rotation | default: 0 }}deg;
    --snosha-comparison-image-width-mobile: {{ section.settings.image_width_mobile }}px;
    --snosha-comparison-image-overhang-mobile: {{ section.settings.image_overhang_mobile }}px;
    --snosha-comparison-image-top-mobile: {{ section.settings.image_top_mobile }}px;
    --snosha-comparison-glow: {{ section.settings.glow_color }};
    --snosha-comparison-floor: {{ section.settings.floor_shadow_color }};
    --snosha-comparison-padding-start: {{ section.settings.padding_top }}px;
    --snosha-comparison-padding-end: {{ section.settings.padding_bottom }}px;
    --snosha-comparison-padding-start-mobile: {{ section.settings.padding_top_mobile }}px;
    --snosha-comparison-padding-end-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }
{% endstyle %}

<div
  class="snosha-comparison{% if show_image %} snosha-comparison--has-image{% endif %}{% if show_mobile_image %} snosha-comparison--has-mobile-image{% endif %}{% if custom_class != blank %} {{ custom_class }}{% endif %}"
>
  <div class="section section--page-width">
    <div class="snosha-comparison__inner">
      <div class="snosha-comparison__heading" id="SnoshaComparisonHeading-{{ section.id }}">
        {% content_for 'block', type: 'text', id: 'heading' %}
        {% content_for 'block', type: 'text', id: 'subtitle' %}
      </div>

      <div class="snosha-comparison__board">
        {%- if section.settings.show_glow -%}
          <span class="snosha-comparison__glow snosha-comparison__glow--board" aria-hidden="true"></span>
        {%- endif -%}
        <span class="snosha-comparison__panel" aria-hidden="true"></span>
        <span class="snosha-comparison__strip" aria-hidden="true"></span>

        {%- comment -%} Accessible name = the section's visible heading + subtitle {%- endcomment -%}
        <table class="snosha-comparison__table" aria-labelledby="SnoshaComparisonHeading-{{ section.id }}">
          <thead>
            <tr>
              <th scope="col" class="snosha-comparison__cell snosha-comparison__cell--criterion">
                {%- if criterion_label_mobile != blank and criterion_label_mobile != criterion_label -%}
                  <span class="snosha-comparison__text snosha-comparison__text--desktop">{{ criterion_label | escape }}</span>
                  <span class="snosha-comparison__text snosha-comparison__text--mobile">{{ criterion_label_mobile | escape }}</span>
                {%- else -%}
                  <span class="snosha-comparison__text">{{ criterion_label | escape }}</span>
                {%- endif -%}
              </th>
              <th scope="col" class="snosha-comparison__cell snosha-comparison__cell--brand">
                {%- if logo != blank -%}
                  {%- capture logo_sizes -%}(min-width: 750px) {{ section.settings.logo_width }}px, {{ section.settings.logo_width_mobile }}px{%- endcapture -%}
                  {{
                    logo
                    | image_url: width: 600
                    | image_tag:
                      class: 'snosha-comparison__logo',
                      alt: brand_label,
                      widths: '120, 160, 240, 320, 480, 600',
                      sizes: logo_sizes,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="snosha-comparison__brand-text">{{ brand_label | escape }}</span>
                {%- endif -%}
              </th>
              <th scope="col" class="snosha-comparison__cell snosha-comparison__cell--manual">
                {%- if manual_label_mobile != blank and manual_label_mobile != manual_label -%}
                  <span class="snosha-comparison__text snosha-comparison__text--desktop">{{ manual_label | escape }}</span>
                  <span class="snosha-comparison__text snosha-comparison__text--mobile">{{ manual_label_mobile | escape }}</span>
                {%- else -%}
                  <span class="snosha-comparison__text">{{ manual_label | escape }}</span>
                {%- endif -%}
              </th>
            </tr>
          </thead>
          <tbody>
            {%- content_for 'blocks' -%}
          </tbody>
        </table>

        {%- if show_image or show_mobile_image -%}
          {%- liquid
            # 750–989px renders the desktop image at 0.7 scale (assets/dev1.css, --snosha-comparison-scale)
            assign image_width = section.settings.image_width
            capture desktop_sizes
              echo '(min-width: 990px) ' | append: image_width | append: 'px, calc(' | append: image_width | append: 'px * 0.7)'
            endcapture
            assign mobile_sizes = section.settings.image_width_mobile | append: 'px'
            capture shared_sizes
              echo '(min-width: 990px) ' | append: image_width | append: 'px, (min-width: 750px) calc('
              echo image_width | append: 'px * 0.7), ' | append: mobile_sizes
            endcapture
            assign shared_image = false
            if section.settings.image_mobile == blank
              assign shared_image = true
            endif
            assign desktop_alt = desktop_image.alt | default: product.title | default: ''
            assign mobile_alt = mobile_image.alt | default: product.title | default: ''
          -%}
          <div class="snosha-comparison__media">
            {%- if section.settings.show_glow -%}
              <span class="snosha-comparison__glow snosha-comparison__glow--media" aria-hidden="true"></span>
            {%- endif -%}
            {%- if section.settings.show_floor_shadow -%}
              <span class="snosha-comparison__floor" aria-hidden="true"></span>
            {%- endif -%}
            {%- if shared_image -%}
              {{
                desktop_image
                | image_url: width: 1200
                | image_tag:
                  class: 'snosha-comparison__image',
                  alt: desktop_alt,
                  widths: '150, 200, 300, 400, 600, 800, 1000, 1200',
                  sizes: shared_sizes,
                  loading: 'lazy'
              }}
            {%- else -%}
              {%- if show_image -%}
                {{
                  desktop_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'snosha-comparison__image snosha-comparison__image--desktop',
                    alt: desktop_alt,
                    widths: '300, 400, 600, 800, 1000, 1200',
                    sizes: desktop_sizes,
                    loading: 'lazy'
                }}
              {%- endif -%}
              {{
                mobile_image
                | image_url: width: 600
                | image_tag:
                  class: 'snosha-comparison__image snosha-comparison__image--mobile',
                  alt: mobile_alt,
                  widths: '150, 200, 300, 400, 600',
                  sizes: mobile_sizes,
                  loading: 'lazy'
              }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Snosha comparison",
  "tag": "section",
  "class": "snosha-comparison-section",
  "blocks": [
    { "type": "_snosha-comparison-row" }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit the heading and subtitle in their blocks. Each Comparison row block is one table row: add, remove or drag rows to reorder them."
    },
    {
      "type": "header",
      "content": "Table headers"
    },
    {
      "type": "text",
      "id": "criterion_label",
      "label": "Criterion column (desktop)",
      "default": "المعيار"
    },
    {
      "type": "text",
      "id": "criterion_label_mobile",
      "label": "Criterion column (mobile, optional)"
    },
    {
      "type": "text",
      "id": "manual_label",
      "label": "Compared product column (desktop)",
      "default": "الفرشاة اليدوية العادية"
    },
    {
      "type": "text",
      "id": "manual_label_mobile",
      "label": "Compared product column (mobile, optional)",
      "default": "اليدوية العادية"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Highlighted product name",
