      "info": "On the criterion side of the table.",
      "min": -100,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 172
    },
    {
      "type": "range",
      "id": "image_top",
      "label": "Top offset from the table (desktop)",
      "min": -300,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": -88
    },
    {
      "type": "number",
