{%- comment -%}
  Usage step (private theme block of sections/snosha-how-to-use.liquid).
  Renders one <li> of the section's ordered list. The number badge is not stored anywhere:
  it is a CSS counter (assets/dev1.css, .snosha-how-to-use__badge), so numbering always follows
  the current rendered order. Hidden (disabled) blocks and empty steps are not rendered, so they
  never leave a gap. The counter is generated content, so screen readers announce it with the step.
  A blank mobile text falls back to the main text; the two variants are toggled with CSS at
  Horizon's 750px breakpoint (display: none keeps the hidden one out of the accessibility tree).
{%- endcomment -%}
{%- liquid
  assign desktop_text = block.settings.text | strip
  assign mobile_text = block.settings.text_mobile | strip
  if desktop_text == blank
    assign desktop_text = mobile_text
  endif
-%}
{%- if desktop_text != blank or request.design_mode -%}
  <li class="snosha-how-to-use__step" {{ block.shopify_attributes }}>
    <span class="snosha-how-to-use__badge"></span>
    <span class="snosha-how-to-use__step-text">
      {%- if mobile_text != blank and mobile_text != desktop_text -%}
        <span class="snosha-how-to-use__text snosha-how-to-use__text--desktop">{{ desktop_text }}</span>
        <span class="snosha-how-to-use__text snosha-how-to-use__text--mobile">{{ mobile_text }}</span>
      {%- else -%}
        <span class="snosha-how-to-use__text">{{ desktop_text }}</span>
      {%- endif -%}
    </span>
  </li>
{%- endif -%}

{% schema %}
{
  "name": "Usage step",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Instruction"
    },
    {
      "type": "inline_richtext",
      "id": "text_mobile",
      "label": "Instruction on mobile",
      "info": "Optional. Leave blank to show the instruction above on mobile."
    },
    {
      "type": "paragraph",
      "content": "The step number is automatic: drag steps to reorder them, or hide / remove a step, and the numbers update."
    }
  ],
  "presets": [
    {
      "name": "Usage step",
      "settings": {
        "text": "New step"
      }
    }
  ]
}
{% endschema %}
