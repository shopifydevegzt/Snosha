{%- comment -%}
  Long Description — Typography (private static theme block of sections/snosha-long-description.liquid,
  id "typography"). Holds the text sizes, line heights and weights so the section stays under
  Shopify's 40-setting advisory (Theme Check ExcessiveSettingsCount). It renders no visible markup:
  only scoped CSS variables (--snosha-ld-*) consumed by assets/main.css (.snosha-long-description).
  If this block is hidden, the CSS falls back to the Figma values.
  Figma: headings Cairo Bold 32/52 (mobile 21/52; Intro 22/52); body 16/28 (mobile 13.5/28);
  Intro body 18/32 (mobile 12/24); list title Bold 16/27 (mobile 14.5/27); list description
  14/24 (mobile 12/24); compact list on mobile (Box contents) 12.5 / 10.5; subtitle SemiBold 24/40
  (mobile Medium 16/24, Cleaning modes); note and list label SemiBold 14/24 (mobile 12/24, Battery).
  Indicator rows use the list title / description sizes (identical in Figma).
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
-%}
{% style %}
  #shopify-section-{{ section.id }} .snosha-long-description {
    --snosha-ld-heading-size: {{ bs.heading_size }}px;
    --snosha-ld-heading-size-mobile: {{ bs.heading_size_mobile }}px;
    --snosha-ld-intro-heading-size-mobile: {{ bs.intro_heading_size_mobile }}px;
    --snosha-ld-heading-line-height: {{ bs.heading_line_height }}px;
    --snosha-ld-heading-weight: {{ bs.heading_weight }};
    --snosha-ld-body-size: {{ bs.body_size }}px;
    --snosha-ld-body-size-mobile: {{ bs.body_size_mobile }}px;
    --snosha-ld-body-line-height: {{ bs.body_line_height }}px;
    --snosha-ld-body-line-height-mobile: {{ bs.body_line_height_mobile }}px;
    --snosha-ld-intro-body-size: {{ bs.intro_body_size }}px;
    --snosha-ld-intro-body-size-mobile: {{ bs.intro_body_size_mobile }}px;
    --snosha-ld-intro-body-line-height: {{ bs.intro_body_line_height }}px;
    --snosha-ld-intro-body-line-height-mobile: {{ bs.intro_body_line_height_mobile }}px;
    --snosha-ld-item-title-size: {{ bs.item_title_size }}px;
    --snosha-ld-item-title-size-mobile: {{ bs.item_title_size_mobile }}px;
    --snosha-ld-item-title-line-height: {{ bs.item_title_line_height }}px;
    --snosha-ld-item-title-weight: {{ bs.item_title_weight }};
    --snosha-ld-item-desc-size: {{ bs.item_desc_size }}px;
    --snosha-ld-item-desc-size-mobile: {{ bs.item_desc_size_mobile }}px;
    --snosha-ld-item-desc-line-height: {{ bs.item_desc_line_height }}px;
    --snosha-ld-compact-title-size-mobile: {{ bs.compact_title_size_mobile }}px;
    --snosha-ld-compact-desc-size-mobile: {{ bs.compact_desc_size_mobile }}px;
    --snosha-ld-subtitle-size: {{ bs.subtitle_size }}px;
    --snosha-ld-subtitle-size-mobile: {{ bs.subtitle_size_mobile }}px;
    --snosha-ld-subtitle-line-height: {{ bs.subtitle_line_height }}px;
    --snosha-ld-subtitle-line-height-mobile: {{ bs.subtitle_line_height_mobile }}px;
    --snosha-ld-subtitle-weight: {{ bs.subtitle_weight }};
    --snosha-ld-subtitle-weight-mobile: {{ bs.subtitle_weight_mobile }};
    --snosha-ld-note-size: {{ bs.note_size }}px;
    --snosha-ld-note-size-mobile: {{ bs.note_size_mobile }}px;
    --snosha-ld-note-line-height: {{ bs.note_line_height }}px;
    --snosha-ld-note-weight: {{ bs.note_weight }};
  }
{% endstyle %}

