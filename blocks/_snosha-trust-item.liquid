{%- doc -%}
  Snosha — one trust pill (child of snosha-trust-list). Figma "Trust Pill" 412:5024.
  Renders nothing when the text is empty.
{%- enddoc -%}
{%- liquid
  assign block_settings = block.settings
  assign pill_text = block_settings.text | strip
  assign pill_tag = 'span'
  if block_settings.link != blank
    assign pill_tag = 'a'
  endif
-%}
{%- if pill_text != blank -%}
  <li class="snosha-trust__item" {{ block.shopify_attributes }}>
    <{{ pill_tag }}
      class="snosha-trust__pill"
      {% if pill_tag == 'a' %}
        href="{{ block_settings.link }}"
      {% endif %}
    >
      {%- if block_settings.image != blank -%}
        <span class="snosha-trust__tile snosha-trust__tile--image" aria-hidden="true">
          {{- block_settings.image | image_url: width: 84 | image_tag: width: 28, height: 28, alt: '', loading: 'lazy' -}}
        </span>
      {%- elsif block_settings.icon != 'none' -%}
        <span class="snosha-trust__tile" aria-hidden="true">
          {%- render 'snosha-icon', icon: block_settings.icon, uid: block.id -%}
        </span>
      {%- endif -%}
      <span class="snosha-trust__text">{{ pill_text | escape }}</span>
    </{{ pill_tag }}>
  </li>
{%- endif -%}

{% schema %}
{
  "name": "Trust pill",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "الدفع عند الاستلام"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "exchange", "label": "Exchange" },
        { "value": "shield_check", "label": "Shield" },
        { "value": "wallet", "label": "Wallet" },
        { "value": "package", "label": "Package" },
        { "value": "truck", "label": "Truck" },
        { "value": "cart", "label": "Cart" },
        { "value": "check", "label": "Check" },
        { "value": "discount", "label": "Discount" },
        { "value": "document", "label": "Document" },
        { "value": "none", "label": "None" }
      ],
      "default": "wallet"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom icon image",
      "info": "Replaces the icon. Shown in the 28 px tile."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)",
      "info": "For example your shipping or refund policy page."
    }
  ]
}
{% endschema %}
