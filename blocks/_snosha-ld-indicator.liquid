{%- comment -%}
  Long Description — Indicator light row (private theme block of blocks/_snosha-ld-panel.liquid).
  Figma "LED Row" 190:10639 (desktop) / 190:11386 (mobile): 52 px white tile with a 15 px light
  that glows in its own color, + title + description.
  Styles:
    glow — the light only (Figma "ثبات أحمر" / "ثبات أخضر": steady)
    ring — the light + a dashed ring (Figma "وميض أحمر": flashing, drawn statically in Figma)
  "Pulse" is an optional CSS animation, off by default, and never runs when the visitor prefers
  reduced motion. No JavaScript. The meaning is always carried by the title text, not the color.
  Markup: snippets/snosha-ld-indicator.liquid (shared with the panel's optional metaobject items).
{%- endcomment -%}
{%- render 'snosha-ld-indicator',
  title: block.settings.title,
  description: block.settings.description,
  light_color: block.settings.light_color,
  light_style: block.settings.light_style,
  pulse: block.settings.pulse,
  show_empty: request.design_mode,
  attributes: block.shopify_attributes
-%}

{% schema %}
{
  "name": "Indicator light",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "light_color",
      "label": "Light color",
      "default": "#E5484D"
    },
    {
      "type": "select",
      "id": "light_style",
      "label": "Style",
      "options": [
        { "value": "glow", "label": "Light with glow (steady)" },
        { "value": "ring", "label": "Light with dashed ring (flashing)" }
      ],
      "default": "glow"
    },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Pulse animation",
      "info": "Off in Figma. Never plays for visitors who prefer reduced motion.",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description"
    }
  ],
  "presets": [
    {
      "name": "Indicator light"
    }
  ]
}
{% endschema %}
