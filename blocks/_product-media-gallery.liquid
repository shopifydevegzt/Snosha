
{% render 'product-media-gallery-content',
  media_presentation: block.settings.media_presentation,
  block_settings: block.settings,
  block_id: block.id,
  block_shopify_attributes: block.shopify_attributes,
  block: block,
  section: section
%}

{% schema %}
{
  "name": "t:names.product_media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_presentation",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid",
      "info": "t:info.carousel_layout_on_mobile"
    },
    {
      "type": "header",
      "content": "t:content.grid",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "select",
      "id": "media_columns",
      "label": "t:settings.columns",
      "options": [
        {
          "value": "one",
          "label": "t:options.one_number"
        },
        {
          "value": "two",
          "label": "t:options.two_number"
        }
      ],
      "default": "one",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "large_first_image",
      "label": "t:settings.full_width_first_image",
      "default": false,
      "visible_if": "{{ block.settings.media_presentation == 'grid' and block.settings.media_columns == 'two' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icons",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.large_arrows"
        },
        {
          "value": "chevron_large",
          "label": "t:options.large_chevrons"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "t:settings.desktop_pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "thumbnails",
          "label": "t:options.thumbnails"
        }
      ],
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_mobile_controls_style",
      "label": "t:settings.mobile_pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "hint",
          "label": "t:options.hint"
        },
        {
          "value": "thumbnails",
          "label": "t:options.thumbnails"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.thumbnails",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "t:settings.desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.direction_start"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        },
        {
          "value": "right",
          "label": "t:options.direction_end"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "t:settings.width_desktop",
      "min": 44,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "1/1.25",
          "label": "t:options.portrait"
        },
        {
          "value": "1",
          "label": "t:options.square"
        },
        {
          "value": "2/1",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "label": "t:settings.limit_media_to_screen_height",
      "default": false
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:settings.media_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.aspect_ratio == 'adapt' and block.settings.constrain_to_viewport == true }}"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "extend_media",
      "label": "t:settings.extend_media_to_screen_edge",
      "default": true,
      "visible_if": "{{ section.settings.content_width == 'content-center-aligned' }}"
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "t:settings.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.enable_video_looping",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:settings.hide_unselected_variant_media"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Snosha stage"
    },
    {
      "type": "checkbox",
      "id": "snosha_style",
      "label": "Use Snosha stage style",
      "info": "For the Carousel layout with Thumbnails at the bottom. Media sits in a rounded stage (Figma 712 : 660 desktop, 352 : 364 mobile) and keeps its own proportions. Use Media fit = Contain.",
      "default": false
    },
    {
      "type": "select",
      "id": "snosha_media_fit",
      "label": "Stage media fit",
      "info": "Contain shows the whole image or video. Cover fills the stage and crops the edges of media whose proportions differ from the stage.",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_stage_background",
      "label": "Stage background",
      "alpha": true,
      "default": "#EBEDEED9",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_stage_border",
      "label": "Stage border",
      "default": "{{ settings.color_palette.color2 }}",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "range",
      "id": "snosha_stage_radius",
      "label": "Stage corner radius (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 28,
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "range",
      "id": "snosha_stage_radius_mobile",
      "label": "Stage corner radius (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22,
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "range",
      "id": "snosha_thumb_size",
      "label": "Thumbnail size (desktop)",
      "info": "Replaces the thumbnail width above. Thumbnail corner radius above applies to desktop.",
      "min": 44,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 104,
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "range",
      "id": "snosha_thumb_size_mobile",
      "label": "Thumbnail size (mobile)",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 66,
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "range",
      "id": "snosha_thumb_radius_mobile",
      "label": "Thumbnail corner radius (mobile)",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_thumb_border",
      "label": "Thumbnail border",
      "default": "{{ settings.color_palette.color2 }}",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_thumb_active",
      "label": "Selected thumbnail border",
      "default": "{{ settings.color_palette.color3 }}",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "checkbox",
      "id": "snosha_show_zoom_button",
      "label": "Show zoom button",
      "info": "Opens the zoom view of the shown media. Needs Image zoom on.",
      "default": true,
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_zoom_background",
      "label": "Zoom button background",
      "alpha": true,
      "default": "#FFFFFFEB",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_zoom_icon",
      "label": "Zoom button icon",
      "default": "{{ settings.color_palette.color3 }}",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "text",
      "id": "snosha_badge_text",
      "label": "Badge text",
      "default": "الأكثر مبيعًا",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "text",
      "id": "snosha_badge_tag",
      "label": "Show badge on products tagged",
      "info": "Exact product tag. The badge shows only on products with this tag; leave empty to hide it.",
      "default": "الاكثر مبيعا",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_badge_background",
      "label": "Badge background",
      "default": "{{ settings.color_palette.color3 }}",
      "visible_if": "{{ block.settings.snosha_style }}"
    },
    {
      "type": "color",
      "id": "snosha_badge_text_color",
      "label": "Badge text",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.snosha_style }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_media"
    }
  ]
}
{% endschema %}
