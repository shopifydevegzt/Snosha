{%- comment -%}
  Snosha icon (theme block): one icon from snippets/snosha-icon.liquid (Figma "Icon / *" set),
  optionally on the Figma light-gradient tile. Horizon's native icon block has no tooth / sparkle /
  timer artwork matching the design; an uploaded image replaces the built-in icon.
  Styles: assets/dev1.css (.snosha-icon-block). Colors are per-block settings.
{%- endcomment -%}
{%- liquid
  assign block_settings = block.settings
  # "large" = Figma Why SNOSHA tile (96px tile, 64px illustration); default "small" = 40 / 24.
  assign icon_size = 24
  if block_settings.size == 'large'
    assign icon_size = 64
  endif
  # Multi-color illustrations ship as theme assets (assets/snosha-illustration-*.svg).
  assign is_illustration = false
  if block_settings.icon contains 'illustration_'
    assign is_illustration = true
    assign illustration_file = block_settings.icon | remove_first: 'illustration_' | replace: '_', '-' | prepend: 'snosha-illustration-' | append: '.svg'
  endif
-%}
<div
  class="snosha-icon-block{% if block_settings.show_tile %} snosha-icon-block--tile{% endif %}{% if block_settings.size == 'large' %} snosha-icon-block--large{% endif %}"
  style="
    --snosha-icon-color: {{ block_settings.icon_color }};
    --snosha-icon-fill: {{ block_settings.icon_fill_color }};
    --snosha-icon-tile-start: {{ block_settings.tile_start_color }};
    --snosha-icon-tile-end: {{ block_settings.tile_end_color }};
    --snosha-icon-tile-border: {{ block_settings.tile_border_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block_settings.image != blank -%}
    {{
      block_settings.image
      | image_url: width: 192
      | image_tag: width: icon_size, height: icon_size, alt: '', loading: 'lazy', class: 'snosha-icon-block__image'
    }}
  {%- elsif is_illustration -%}
    <img
      class="snosha-icon-block__image"
      src="{{ illustration_file | asset_url }}"
      width="{{ icon_size }}"
      height="{{ icon_size }}"
      alt=""
      loading="lazy"
    >
  {%- else -%}
    {%- render 'snosha-icon', icon: block_settings.icon, uid: block.id, class: 'snosha-icon-block__icon' -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Snosha icon",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "tooth", "label": "Tooth" },
        { "value": "sparkle_detail", "label": "Sparkle" },
        { "value": "timer", "label": "Timer" },
        { "value": "heart", "label": "Heart" },
        { "value": "shield_check", "label": "Shield" },
        { "value": "truck", "label": "Truck" },
        { "value": "package", "label": "Package" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "sonic", "label": "Sonic" },
        { "value": "battery", "label": "Battery" },
        { "value": "sliders", "label": "Modes" },
        { "value": "illustration_simple_routine", "label": "Illustration: simple routine" },
        { "value": "illustration_details", "label": "Illustration: details" },
        { "value": "illustration_your_needs", "label": "Illustration: your needs" },
        { "value": "illustration_smart_tech", "label": "Illustration: smart tech" }
      ],
      "default": "tooth"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom icon image",
      "info": "Replaces the built-in icon. Square: about 24 px (small) or 64 px (large)."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small (40 px tile)" },
        { "value": "large", "label": "Large (96 px tile)" }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "show_tile",
      "label": "Show tile",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "{{ settings.color_palette.color3 }}"
    },
    {
      "type": "color",
      "id": "icon_fill_color",
      "label": "Icon inner fill",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "tile_start_color",
      "label": "Tile gradient top",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.show_tile }}"
    },
    {
      "type": "color",
      "id": "tile_end_color",
      "label": "Tile gradient bottom",
      "default": "{{ settings.color_palette.color5 }}",
      "visible_if": "{{ block.settings.show_tile }}"
    },
    {
      "type": "color",
      "id": "tile_border_color",
      "label": "Tile border",
      "default": "{{ settings.color_palette.color2 }}",
      "visible_if": "{{ block.settings.show_tile }}"
    }
  ],
  "presets": [
    {
      "name": "Snosha icon",
      "category": "Snosha"
    }
  ]
}
{% endschema %}
