{%- comment -%}
  Snosha — Choose Your Care: one product card (only inside sections/snosha-choose-care.liquid).
  Figma: side card "Care Card" (362:4532) and "Featured Card / SNOSHA N2" inside its glow border
  (190:3966). "Featured" switches this card to the featured variant.
  Price, compare-at price, discount %, availability and URL come from the selected product.
  Spec rows are nested blocks (blocks/_snosha-care-spec.liquid). Styles: assets/main.css.
{%- endcomment -%}
{%- liquid
  assign product = block.settings.product
  assign featured = block.settings.featured
  assign title = block.settings.title | strip
  if title == blank and product != blank
    assign title = product.title
  endif
  assign image = block.settings.image
  if image == blank and product != blank
    assign image = product.featured_image
  endif
  assign discount = 0
  if product != blank and product.compare_at_price > product.price
    assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  assign image_alt = image.alt | default: title | escape

  capture specs
    content_for 'blocks'
  endcapture
  assign specs = specs | strip
-%}
<li
  class="snosha-care-card{% if featured %} snosha-care-card--featured{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="snosha-care-card__inner">
    <div class="snosha-care-card__info">
      <div class="snosha-care-card__image{% if block.settings.image_fit == 'contain' %} snosha-care-card__image--contain{% endif %}">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 816
            | image_tag:
              alt: image_alt,
              widths: '240, 360, 408, 600, 816',
              sizes: '(min-width: 750px) 408px, 232px',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'snosha-care-card__placeholder' }}
        {%- endif -%}

        {%- if block.settings.badge != blank -%}
          <span class="snosha-care-card__badge" dir="auto">{{ block.settings.badge | escape }}</span>
        {%- endif -%}
      </div>

      {%- if title != blank -%}
        <h3 class="snosha-care-card__title" dir="auto">{{ title | escape }}</h3>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <p class="snosha-care-card__text" dir="auto">{{ block.settings.description | escape }}</p>
      {%- endif -%}

      {%- if specs != blank -%}
        <ul class="snosha-care-card__specs" role="list">
          {{- specs -}}
        </ul>
      {%- endif -%}
    </div>

    <div class="snosha-care-card__purchase">
      {%- if product != blank -%}
        <div class="snosha-care-card__prices">
          <span class="snosha-care-card__price">{{ product.price | money }}</span>
          {%- if discount > 0 -%}
            <s class="snosha-care-card__compare">{{ product.compare_at_price | money }}</s>
            {%- if block.settings.discount_label != blank -%}
              <span class="snosha-care-card__discount" dir="auto">{{ block.settings.discount_label | escape }} {{ discount }}%</span>
            {%- endif -%}
          {%- endif -%}
          {%- unless product.available -%}
            <span class="snosha-care-card__sold-out">{{ 'content.product_badge_sold_out' | t }}</span>
          {%- endunless -%}
        </div>
      {%- endif -%}

      {%- if block.settings.button_label != blank -%}
        {%- if product != blank -%}
          <a class="snosha-care-card__button" href="{{ product.url }}">
            <span dir="auto">{{ block.settings.button_label | escape }}</span>
          </a>
        {%- else -%}
          <a class="snosha-care-card__button" role="link" aria-disabled="true">
            <span dir="auto">{{ block.settings.button_label | escape }}</span>
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</li>

{% schema %}
{
  "name": "Care card",
  "tag": null,
  "blocks": [
    {
      "type": "_snosha-care-spec"
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Price, compare-at price, discount, availability and the button link come from this product."
    },
    {
      "type": "checkbox",
      "id": "featured",
      "label": "Featured card",
      "info": "Larger card with the gradient border and glow (Figma: SNOSHA N2).",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Image badge",
      "info": "Optional label on the image, e.g. الأكثر مبيعًا."
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "info": "Shown with the real discount % when the product has a compare-at price.",
      "default": "خصم"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "عرض المنتج"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Replaces the product's featured image in this card."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill"
        },
        {
          "value": "contain",
          "label": "Fit"
        }
      ],
      "default": "cover"
    }
  ],
  "presets": [
    {
      "name": "Care card",
      "blocks": {
        "spec-1": {
          "type": "_snosha-care-spec"
        },
        "spec-2": {
          "type": "_snosha-care-spec"
        }
      },
      "block_order": [
        "spec-1",
        "spec-2"
      ]
    }
  ]
}
{% endschema %}
