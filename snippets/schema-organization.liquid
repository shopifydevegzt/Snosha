{%- doc -%}
  Snosha (project file): the store's Organization JSON-LD, rendered once per page from sections/header.liquid
  (moved out of the header to keep its Liquid complexity under Theme Check's limit). Fields follow the SEO
  implementation spec (Snosha.com Technical SEO Implementation, §7.1); every value comes from Theme settings →
  SEO structured data, and each optional field is omitted when blank.

  @example
  {% render 'schema-organization' %}
{%- enddoc -%}
<script type="application/ld+json">
  {
    {%- comment -%}
      Snosha (project addition): name / description / founder / country / contact from Theme settings; the
      store's primary-domain homepage as url on every page and in every language (one entity). Social URLs need
      a profile path (placeholders like https://www.facebook.com/ are skipped).
    {%- endcomment -%}
    {%- liquid
      assign org_name = settings.seo_org_name | strip | default: shop.name
      assign org_alternate_name = settings.seo_org_alternate_name | strip
      assign org_description = settings.seo_org_description | strip_newlines | strip
      assign org_founding_date = settings.seo_org_founding_date | strip
      assign org_founder = settings.seo_org_founder | strip
      assign org_country_code = settings.seo_org_country_code | strip | upcase
      assign org_country_name = settings.seo_org_country_name | strip

      assign org_same_as = ''
      assign org_same_as_lines = settings.seo_org_same_as | newline_to_br | split: '<br />'
      for line in org_same_as_lines
        assign org_url = line | strip
        assign org_url_parts = org_url | split: '/'
        if org_url_parts.size > 3 and org_url_parts[0] == 'https:' and org_url_parts[3] != blank
          assign org_same_as = org_same_as | append: '|||' | append: org_url
        endif
      endfor
      assign org_same_as = org_same_as | remove_first: '|||' | split: '|||'

      assign org_phone = settings.seo_org_phone | strip | default: shop.phone | strip
      assign org_email = settings.seo_org_email | strip | default: shop.email | strip
      assign org_languages = ''
      assign org_language_items = settings.seo_org_languages | split: ','
      for language in org_language_items
        assign language_name = language | strip
        if language_name != blank
          assign org_languages = org_languages | append: '|||' | append: language_name
        endif
      endfor
      assign org_languages = org_languages | remove_first: '|||' | split: '|||'
    -%}
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ org_name | json }},
    {%- if org_alternate_name != blank %}
      "alternateName": {{ org_alternate_name | json }},
    {%- endif %}
    "url": {{ shop.url | append: '/' | json }},
    {%- if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }},
    {%- endif %}
    {%- if org_description != blank %}
      "description": {{ org_description | json }},
    {%- endif %}
    {%- if org_founding_date != blank %}
      "foundingDate": {{ org_founding_date | json }},
    {%- endif %}
    {%- if org_founder != blank %}
      "founder": { "@type": "Person", "name": {{ org_founder | json }} },
    {%- endif %}
    {%- if settings.seo_org_contact and org_phone != blank or settings.seo_org_contact and org_email != blank %}
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support"
        {%- if org_phone != blank %}, "telephone": {{ org_phone | json }}{% endif %}
        {%- if org_email != blank %}, "email": {{ org_email | json }}{% endif %}
        {%- if org_country_code != blank %}, "areaServed": {{ org_country_code | json }}{% endif %}
        {%- if org_languages.size > 0 %}, "availableLanguage": {{ org_languages | json }}{% endif %}
      },
    {%- endif %}
    {%- if org_country_code != blank %}
      "address": { "@type": "PostalAddress", "addressCountry": {{ org_country_code | json }} },
    {%- endif %}
    {%- if org_country_name != blank %}
      "areaServed": { "@type": "Country", "name": {{ org_country_name | json }} },
    {%- endif %}
    {%- if org_same_as.size > 0 %}
      "sameAs": {{ org_same_as | json }},
    {%- endif %}
    "@id": {{ shop.url | append: '/#organization' | json }}
  }
</script>
