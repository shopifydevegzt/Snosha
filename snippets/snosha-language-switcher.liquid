{%- doc -%}
  Snosha (project file): language dropdown shared by the header (desktop, "Snosha layout" on, language
  selector only) and the footer (blocks/snosha-footer-language.liquid).
  Native Shopify switching: a {% form 'localization' %} whose options are submit buttons named language_code;
  Shopify returns to the localized version of the current page. Open / close, outside click,
  Escape and aria-expanded come from Horizon's <dropdown-localization-component> (assets/localization.js),
  one instance per render, so header and footer work independently. Callers render it only with 2+
  storefront languages. Styles: assets/main.css.

  @param {object} section - The section rendering the switcher.
  @param {string} [form_style] - Horizon's localization font variables (--menu-localization-font…).
  @param {string} [context] - 'header' (default) or 'footer': footer is visible at every width and its panel opens upward.
  @param {string} [id_suffix] - Unique suffix for the panel / form ids (default: section.id).

  @example
  {% render 'snosha-language-switcher', section: section, form_style: form_style %}
  {% render 'snosha-language-switcher', section: section, context: 'footer', id_suffix: block.id %}
{%- enddoc -%}

{%- liquid
  assign switcher_context = context | default: 'header'
  assign switcher_suffix = id_suffix | default: section.id
  assign current_language = localization.language
  assign panel_id = 'SnoshaLanguage-' | append: switcher_suffix
  assign form_id = 'SnoshaLanguageForm-' | append: switcher_suffix
  assign language_label = 'content.language' | t

  assign switcher_visible = true
  assign switcher_class = 'mobile:hidden'
  if switcher_context == 'footer'
    assign switcher_class = 'snosha-language--footer'
  elsif section.settings.snosha_language_desktop == false
    assign switcher_visible = false
  endif
-%}

{%- if switcher_visible -%}
  <dropdown-localization-component
    class="dropdown-localization snosha-language {{ switcher_class }}"
    {% if form_style != blank %}
      style="{{ form_style }}"
    {% endif %}
  >
    <button
      type="button"
      class="snosha-language__trigger"
      ref="button"
      on:click="/toggleSelector"
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
      aria-label="{{ language_label }}: {{ current_language.endonym_name | capitalize | escape }}"
    >
      <span
        class="snosha-language__current"
        lang="{{ current_language.iso_code }}"
      >
        {{- current_language.endonym_name | capitalize -}}
      </span>
      <span
        class="svg-wrapper snosha-language__caret"
        aria-hidden="true"
      >
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>

    <div
      class="snosha-language__panel"
      id="{{ panel_id }}"
      ref="panel"
      hidden
    >
      <localization-form-component ref="localizationForm">
        {%- form 'localization', id: form_id, class: 'snosha-language__form', ref: 'form' -%}
          <ul
            class="snosha-language__list list-unstyled"
            role="list"
            aria-label="{{ language_label }}"
          >
            {%- for language in localization.available_languages -%}
              {%- assign is_current = false -%}
              {%- if language.iso_code == current_language.iso_code -%}
                {%- assign is_current = true -%}
              {%- endif -%}
              <li>
                <button
                  type="submit"
                  name="language_code"
                  value="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  class="snosha-language__option{% if is_current %} snosha-language__option--current{% endif %}"
                  {% if is_current %}
                    aria-current="true"
                  {% endif %}
                >
                  {{- language.endonym_name | capitalize -}}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endform -%}
      </localization-form-component>
    </div>
  </dropdown-localization-component>
{%- endif -%}
