{%- comment -%}
  Cairo (Arabic + Latin, 200–900) served from Shopify Admin → Content → Files.
  Must render AFTER 'theme-styles-variables' so these :root values override
  the font families Horizon generates from the Theme Editor font pickers.
  Sizes, weights, line heights and letter spacing still come from theme settings.
{%- endcomment -%}
{%- liquid
  assign cairo_weights = '200,300,400,500,600,700,800,900' | split: ','
  assign cairo_scripts = 'arabic,latin' | split: ','
  assign arabic_range = 'U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EEF1'
  assign latin_range = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
-%}
<style>
  {%- for script in cairo_scripts -%}
    {%- for weight in cairo_weights -%}
      {%- assign filename = 'cairo-' | append: script | append: '-' | append: weight | append: '-normal.woff2' %}
  @font-face {
    font-family: 'Cairo';
    font-style: normal;
    font-weight: {{ weight }};
    font-display: swap;
    src: url('{{ filename | file_url }}') format('woff2');
    unicode-range: {% if script == 'arabic' %}{{ arabic_range }}{% else %}{{ latin_range }}{% endif %};
  }
    {%- endfor -%}
  {%- endfor %}

  :root {
    --font-body--family: 'Cairo', sans-serif;
    --font-subheading--family: 'Cairo', sans-serif;
    --font-heading--family: 'Cairo', sans-serif;
    --font-accent--family: 'Cairo', sans-serif;
  }
</style>
