{%- doc -%}
  Snosha: one storage & care tab, both halves (button, then panel) separated by
  <!--snosha-tab-split--> and ended by <!--snosha-tab-end-->; sections/snosha-storage-care.liquid pairs
  them. Shared by blocks/_snosha-storage-tab.liquid (Theme Editor block) and the section's optional
  "snosha_care_tab" metaobject entries, so both render identical markup.
  - Storefront: a labelled tab renders; without instructions it shows the section's "Empty tab
    message", or nothing when "Hide tabs without instructions" is on. A tab without a label never renders.
  - Theme Editor (show_empty): every tab renders, with editor-only hints for empty states.

  @param {string} title
  @param {string} [title_mobile]
  @param {boolean} [default_open]
  @param {string} items_markup - rendered <li> items
  @param {string} uid - unique id within the section (block id, or "entry-N")
  @param {string} section_id
  @param {boolean} hide_empty - section setting "Hide tabs without instructions"
  @param {string} [empty_message] - section setting "Empty tab message"
  @param {boolean} [show_empty] - Theme Editor
  @param {string} [attributes] - block.shopify_attributes (Theme Editor blocks only)
{%- enddoc -%}
{%- liquid
  assign title = title | strip
  assign title_mobile = title_mobile | strip
  if title == blank
    assign title = title_mobile
  endif
  assign empty_message = empty_message | strip
  assign renderable = false
  if title != blank
    if items_markup != blank or hide_empty == false
      assign renderable = true
    endif
  endif
-%}
{%- if renderable or show_empty -%}
  <button
    type="button"
    class="snosha-storage-care__tab"
    id="SnoshaCareTab-{{ section_id }}-{{ uid }}"
    role="tab"
    aria-controls="SnoshaCarePanel-{{ section_id }}-{{ uid }}"
    aria-selected="false" tabindex="-1"
    {%- if default_open %} data-snosha-default{% endif %}
  >
    {%- if title == blank -%}
      <span class="snosha-storage-care__text">(no label)</span>
    {%- elsif title_mobile != blank and title_mobile != title -%}
      <span class="snosha-storage-care__text snosha-storage-care__text--desktop">{{ title | escape }}</span>
      <span class="snosha-storage-care__text snosha-storage-care__text--mobile">{{ title_mobile | escape }}</span>
    {%- else -%}
      <span class="snosha-storage-care__text">{{ title | escape }}</span>
    {%- endif -%}
  </button>
  <!--snosha-tab-split-->
  <div
    class="snosha-storage-care__panel"
    id="SnoshaCarePanel-{{ section_id }}-{{ uid }}"
    role="tabpanel"
    aria-labelledby="SnoshaCareTab-{{ section_id }}-{{ uid }}"
    tabindex="0"
    data-snosha-tab-panel hidden
    {{ attributes }}
  >
    {%- if items_markup != blank -%}
      <ul class="snosha-storage-care__list" role="list">
        {{- items_markup -}}
      </ul>
    {%- elsif renderable == false -%}
      <p class="snosha-storage-care__editor-hint">Theme Editor only: this tab is hidden on the storefront (no label, or no instructions while "Hide tabs without instructions" is on).</p>
    {%- elsif empty_message != blank -%}
      <p class="snosha-storage-care__empty">{{ empty_message }}</p>
    {%- elsif show_empty -%}
      <p class="snosha-storage-care__editor-hint">Theme Editor only: add instructions to this tab, or set an "Empty tab message" in the section settings.</p>
    {%- endif -%}
  </div>
  <!--snosha-tab-end-->
{%- endif -%}
