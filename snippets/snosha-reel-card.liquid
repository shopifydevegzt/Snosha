{%- doc -%}
  Snosha: one reel card (<li>) of sections/snosha-reels.liquid. Shared by the section's "Reel" blocks and
  its optional "snosha_reel" metaobject entries, so both render identical markup. Video: Horizon's
  native <deferred-media> (assets/media.js). Without a video (Theme Editor only) a placeholder + hint.

  @param {object} video - Shopify video
  @param {object} [cover] - cover image (defaults to the video's preview image)
  @param {object} [product] - linked product
  @param {string} [label] - accessible label (defaults to the video alt, then the product title)
  @param {boolean} [initial] - the middle reel (initial scroll target)
  @param {string} poster_sizes - sizes attribute for the cover
  @param {string} [unavailable_label] - section setting "Unavailable label"
  @param {boolean} [use_currency_code]
  @param {string} [attributes] - block.shopify_attributes (Theme Editor blocks only)
{%- enddoc -%}
{%- liquid
  assign poster = cover | default: video.preview_image
  assign reel_label = label | default: video.alt | default: product.title | strip | escape
  if reel_label != blank
    assign play_label = 'blocks.load_video' | t: description: reel_label
  else
    assign play_label = 'accessibility.play_video' | t
  endif
-%}
<li
  class="snosha-reel{% if initial %} snosha-reel--initial{% endif %}"
  {{ attributes }}
>
  <div class="snosha-reel__frame">
    {%- if video != blank -%}
      <deferred-media class="snosha-reel__media">
        <button
          type="button"
          class="deferred-media__poster-button snosha-reel__poster"
          ref="deferredMediaPlayButton"
          on:click="/showDeferredMedia"
          aria-label="{{ play_label }}"
        >
          {%- if poster != blank -%}
            {{
              poster
              | image_url: width: 870
              | image_tag:
                widths: '248, 290, 496, 580, 744, 870',
                sizes: poster_sizes,
                loading: 'lazy',
                alt: '',
                class: 'deferred-media__poster-image snosha-reel__poster-image'
            }}
          {%- endif -%}
          <span class="snosha-reel__play" aria-hidden="true">
            <img
              src="{{ 'snosha-reels-play.svg' | asset_url }}"
              alt=""
              width="24"
              height="24"
              loading="lazy"
            >
          </span>
        </button>
        <template>
          {{-
            video
            | video_tag:
              image_size: '1080x',
              autoplay: true,
              controls: true,
              playsinline: true,
              muted: false,
              preload: 'metadata',
              class: 'snosha-reel__video'
          -}}
        </template>
      </deferred-media>
    {%- else -%}
      {%- comment -%}
        Theme Editor only: no playable video on this block (none chosen/saved, or the
        upload hasn't finished processing). Shows the chosen cover if there is one; the
        generic placeholder only when the block has no media at all.
      {%- endcomment -%}
      <div class="snosha-reel__placeholder">
        {%- if cover != blank -%}
          {{
            cover
            | image_url: width: 870
            | image_tag:
              widths: '248, 290, 496, 580, 744, 870',
              sizes: poster_sizes,
              loading: 'lazy',
              alt: '',
              class: 'snosha-reel__poster-image'
          }}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'snosha-reel__placeholder-svg' }}
        {%- endif -%}
        <span class="snosha-reel__editor-hint">
          No video yet: choose a Shopify video for this reel. A new upload appears once Shopify has
          finished processing it. Reels without a video are hidden on the storefront.
        </span>
        <span class="snosha-reel__play" aria-hidden="true">
          <img
            src="{{ 'snosha-reels-play.svg' | asset_url }}"
            alt=""
            width="24"
            height="24"
            loading="lazy"
          >
        </span>
      </div>
    {%- endif -%}
  </div>

  {%- if product != blank -%}
    <a class="snosha-reel__product" href="{{ product.url }}">
      <span class="snosha-reel__thumb">
        {%- if product.featured_image != blank -%}
          {{
            product.featured_image
            | image_url: width: 129
            | image_tag: widths: '43, 86, 129', sizes: '43px', loading: 'lazy', alt: ''
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </span>
      <span class="snosha-reel__info">
        <span class="snosha-reel__title" dir="auto">{{ product.title | escape }}</span>
        <span class="snosha-reel__price">
          {%- if product.available == false -%}
            {%- if unavailable_label != blank -%}
              {{- unavailable_label | escape -}}
            {%- else -%}
              {{- 'products.product.sold_out' | t -}}
            {%- endif -%}
          {%- else -%}
            {%- liquid
              if use_currency_code
                assign product_price = product.price | money_with_currency
              else
                assign product_price = product.price | money
              endif
            -%}
            {%- if product.price_varies -%}
              {{- 'content.price_from' | t: price: product_price -}}
            {%- else -%}
              {{- product_price -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </span>
    </a>
  {%- endif -%}
</li>
{%- # no trailing whitespace after the card -%}
