            "padding-inline-end": 0
          },
          "blocks": {
            "accordion_row_YWatef": {
              "type": "_accordion-row",
              "settings": {
                "heading": "هل ينفع نستخدم فرشاة واحدة ونغيّر الرأس بس؟",
                "open_by_default": false,
                "icon": "none",
                "width": 20,
                "snosha_icon": "none",
                "hide_when_empty": false
              },
              "blocks": {
                "text_tLmL3w": {
                  "type": "text",
                  "settings": {
                    "text": "<p>لأ. الفرشاة أداة شخصية ومينفعش تتشارك لأسباب صحية، وده سبب إن الباقة فيها فرشتين.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_tLmL3w"
              ]
            },
            "accordion_row_AtGm7a": {
              "type": "_accordion-row",
              "settings": {
                "heading": "منظف اللسان ضروري ولا الفرشاة كفاية؟",
                "open_by_default": false,
                "icon": "none",
                "width": 20,
                "snosha_icon": "none",
                "hide_when_empty": false
              },
              "blocks": {
                "text_gEJD8z": {
                  "type": "text",
                  "settings": {
                    "text": "<p>الفرشاة بتنظف السنان، لكن الطبقة اللي على اللسان محتاجة أداة مخصوصة. المنظف بيكمّل الروتين في 10 ثواني.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_gEJD8z"
              ]
            },
            "accordion_row_7UqQnE": {
              "type": "_accordion-row",
              "settings": {
                "heading": "منظف اللسان بيوجع أو بيسبب ترجيع؟",
                "open_by_default": false,
                "icon": "none",
                "width": 20,
                "snosha_icon": "none",
                "hide_when_empty": false
              },
              "blocks": {
                "text_9KMKqA": {
                  "type": "text",
                  "settings": {
                    "text": "<p>لو استخدمته برفق ومدخلتوش لآخر الحلق مش هيوجع. ابدأ من نص اللسان لو حسيت بإحساس الترجيع، وزوّد المسافة مع الوقت.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_9KMKqA"
              ]
            },
            "accordion_row_bundlefaq04": {
              "type": "_accordion-row",
              "settings": {
                "heading": "الـ 16 رأس هيكفّونا قد إيه؟",
                "open_by_default": false,
                "icon": "none",
                "width": 20,
                "snosha_icon": "none",
                "hide_when_empty": false
              },
              "blocks": {
                "text_bundlefaq04": {
                  "type": "text",
                  "settings": {
                    "text": "<p>كل فرشاة جاية معاها 8 رؤوس، والرأس بيتغير كل 3 شهور تقريبًا. يعني حوالي سنتين لكل واحد فيكم.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_bundlefaq04"
              ]
            },
            "accordion_row_bundlefaq05": {
              "type": "_accordion-row",
              "settings": {
                "heading": "ينفع نختار لونين مختلفين للفرشتين؟",
                "open_by_default": false,
                "icon": "none",
                "width": 20,
                "snosha_icon": "none",
                "hide_when_empty": false
              },
              "blocks": {
                "text_bundlefaq05": {
                  "type": "text",
                  "settings": {
                    "text": "<p>أيوه، تقدر تختار أي لونين للفرشتين من الأربعة (وردي، أزرق، أبيض، أسود)، وكمان لون كل منظف لسان (برتقالي، أخضر، أزرق، أسود).</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
