                  "blocks": {}
                }
              },
              "block_order": [
                "text_bundlefaq05"
              ]
            },
            "accordion_row_bundlefaq06": {
              "type": "_accordion-row",
              "settings": {
                "heading": "هل الفرشاة مناسبة للأسنان الحساسة؟",
                "open_by_default": false,
                "icon": "none",
                "width": 20,
                "snosha_icon": "none",
                "hide_when_empty": false
              },
              "blocks": {
                "text_bundlefaq06": {
                  "type": "text",
                  "settings": {
                    "text": "<p>أيوه. فيه وضع Sensitive اهتزازه ألطف، ومع الباقة 4 رؤوس مخصوصة للأسنان الحساسة.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
